# SECURITY-001: template PRODUKSI. Untuk dev lokal, ubah di .env (bukan di file ini): APP_ENV=local, APP_DEBUG=true,
# FORCE_HTTPS=false. APP_KEY dan JWT_SECRET WAJIB dibuat per lingkungan dan BERBEDA antara dev dan produksi.
APP_NAME=Laravel
APP_ENV=production
# Dibuat per lingkungan: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Logging dasar (SECURITY-001): file harian di storage/logs, simpan 14 hari, hanya level warning ke atas.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=anak_tumbuh_be
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT (tymon/jwt-auth). Dibuat per lingkungan: php artisan jwt:secret --show. JANGAN memakai nilai dev di produksi.
JWT_SECRET=

# CORS: daftar origin FE yang diizinkan, dipisah koma, persis skema://host[:port] (tanpa wildcard/path).
# Kosong di produksi = tidak ada origin lintas-domain yang diizinkan. Contoh: https://app.example.com
CORS_ALLOWED_ORIGINS=

# HTTPS dipaksa (redirect 308 + HSTS). Di belakang reverse proxy/CDN, WAJIB isi TRUSTED_PROXIES
# (IP proxy dipisah koma, atau * bila proxy tidak bisa disebut), jika tidak -> redirect berulang.
FORCE_HTTPS=true
TRUSTED_PROXIES=

# Password awal 2 akun Super Admin (php artisan db:seed). WAJIB diisi lewat deployment/secret
# (jangan commit nilai asli). Kosong = password acak per akun; setel lewat
# `php artisan admin:reset-password`.
SEED_SUPER_ADMIN_PASSWORD=
