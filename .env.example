# SECURITY-001: template PRODUKSI. Untuk dev lokal, ubah di .env (bukan di file ini): APP_ENV=local, APP_DEBUG=true,
# FORCE_HTTPS=false. APP_KEY dan JWT_SECRET WAJIB dibuat per lingkungan dan BERBEDA antara dev dan produksi.
APP_NAME=Laravel
APP_ENV=production
# Dibuat per lingkungan: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Logging dasar (SECURITY-001): file harian di storage/logs, simpan 14 hari, hanya level warning ke atas.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=anak_tumbuh_be
DB_USERNAME=postgres
DB_PASSWORD=

# DEPLOY-RUNTIME-001 (D-27): koneksi aplikasi ke Supabase lewat pooler mode transaksi.
# Isi nilai sebenarnya HANYA di environment platform (Vercel), jangan commit.
# DB_URL = URL koneksi pooler; bila diisi, mengalahkan DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
# DB_URL=
# DB_SSLMODE: prefer (lokal); require atau verify-full (+ DB_SSLROOTCERT) untuk Supabase.
DB_SSLMODE=prefer
# DB_SSLROOTCERT=
# DB_DISABLE_PREPARES: true untuk pooler mode transaksi (query dan parameter dikirim sekaligus, tanpa prepared
# statement bernama); false untuk lokal. Opsi yang disarankan (D-27, usulan perubahan mekanisme).
DB_DISABLE_PREPARES=false
# DB_EMULATE_PREPARES: JANGAN true. PDO menyusun query di klien dan boolean menjadi 1/0, sehingga
# `where is_active = 1` ditolak PostgreSQL (terbukti pada suite). Dibiarkan false; hanya untuk eksperimen.
DB_EMULATE_PREPARES=false
# Koneksi khusus langkah rilis, dipakai lewat --database=pgsql_direct. D-27 (usulan): pooler mode SESSION (port 5432),
# karena koneksi langsung Supabase hanya IPv6 (IPv4 = add-on berbayar):
#   php artisan migrate --database=pgsql_direct --force
#   php artisan db:seed --database=pgsql_direct --force
# Nilai DB_DIRECT_* yang kosong jatuh ke DB_* yang sama. Bila aplikasi lewat pooler, isi DB_DIRECT_URL atau DB_DIRECT_HOST.
# DB_DIRECT_URL=
# DB_DIRECT_HOST=
# DB_DIRECT_PORT=
# DB_DIRECT_DATABASE=
# DB_DIRECT_USERNAME=
# DB_DIRECT_PASSWORD=
# DB_DIRECT_SSLMODE=
# DB_DIRECT_SSLROOTCERT=

# Sesi dan antrean TIDAK dipakai aplikasi ini (API stateless JWT, import sinkron, tanpa scheduler).
# Nilai di bawah hanya bawaan Laravel; tidak perlu tabel sessions/jobs di produksi.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# CACHE_STORE=database WAJIB: blacklist JWT (logout, ganti password) dan rate limit login memakai cache.
# Jangan pakai array/file/null di produksi (token yang dicabut tetap berlaku; limit tidak tercatat lintas request).
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

# DEPLOY-STORAGE-001 (D-28, usulan): penyimpanan foto Student dan logo School di Supabase Storage (S3).
# Default 'local' = perilaku lama (dev dan test). Di cloud isi 's3' dan semua variabel di bawah.
# Nilai rahasia hanya di environment platform, JANGAN dikomit.
STORAGE_PRIVATE_DRIVER=local
STORAGE_PUBLIC_DRIVER=local
# Kunci S3 (rahasia). Di Vercel nama AWS_ACCESS_KEY_ID dan AWS_SECRET_ACCESS_KEY dapat tertimpa kredensial platform;
# isi STORAGE_S3_KEY dan STORAGE_S3_SECRET (didahulukan atas AWS_*; bila kosong AWS_* tetap dipakai).
# STORAGE_S3_KEY=
# STORAGE_S3_SECRET=
# Endpoint S3 Supabase: https://<project-ref>.supabase.co/storage/v1/s3 (path-style wajib true; baris AWS_USE_PATH_STYLE_ENDPOINT di atas).
# AWS_ENDPOINT=
# AWS_PRIVATE_BUCKET=   # bucket PRIVAT: foto Student (hanya lewat GET /students/{id}/photo)
# AWS_PUBLIC_BUCKET=    # bucket PUBLIK: logo School
# AWS_PUBLIC_URL=       # URL dasar objek publik, mis. https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>

VITE_APP_NAME="${APP_NAME}"

# JWT (tymon/jwt-auth). Dibuat per lingkungan: php artisan jwt:secret --show. JANGAN memakai nilai dev di produksi.
JWT_SECRET=

# CORS: daftar origin FE yang diizinkan, dipisah koma, persis skema://host[:port] (tanpa wildcard/path).
# Kosong di produksi = tidak ada origin lintas-domain yang diizinkan. Contoh: https://app.example.com
CORS_ALLOWED_ORIGINS=

# HTTPS dipaksa (redirect 308 + HSTS). Di belakang reverse proxy/CDN, WAJIB isi TRUSTED_PROXIES
# (IP proxy dipisah koma, atau * bila proxy tidak bisa disebut), jika tidak -> redirect berulang.
FORCE_HTTPS=true
TRUSTED_PROXIES=

# Password awal 2 akun Super Admin (php artisan db:seed). WAJIB diisi lewat deployment/secret
# (jangan commit nilai asli). Kosong = password acak per akun; setel lewat
# `php artisan admin:reset-password`.
SEED_SUPER_ADMIN_PASSWORD=
