# DEPLOY-IMAGE-001: FrankenPHP/Caddy untuk Laravel. Document root = public/.
# TLS dihentikan oleh Vercel, jadi Caddy hanya melayani HTTP di port dalam container.
# Port mengikuti variabel PORT, bawaan 80 (dokumentasi resmi Vercel: https://vercel.com/kb/guide/laravel-php-with-docker
# dan https://vercel.com/kb/guide/deploy-php-on-vercel-with-docker). EXPOSE di Dockerfile tidak mengatur port yang
# dirutekan Vercel; yang menentukan adalah PORT (diset ENV PORT=80). Isi belum diuji di Vercel.
{
	auto_https off
	admin off
	frankenphp
	order php_server before file_server
}

:{$PORT:80} {
	root * /app/public
	encode zstd gzip

	# Log akses ke stderr (tidak ada berkas log di disk).
	log {
		output stderr
	}

	php_server
}
